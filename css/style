* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {

    --bg1: #160914;
    --bg2: #431b3d;

    --accent: #ff6098;
    --accent2: #ffc1d9;

    --text-soft: #f4cede;

    --card: rgba(39,19,40,.73);

    --border:
        rgba(255,156,199,.28);

    --glow:
        rgba(255,75,145,.32);


    min-height: 100vh;

    overflow-x: hidden;

    color: white;

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;


    background:

        radial-gradient(
            circle at 15% 10%,
            var(--glow),
            transparent 30%
        ),

        radial-gradient(
            circle at 85% 85%,
            var(--glow),
            transparent 32%
        ),

        linear-gradient(
            135deg,
            var(--bg1),
            var(--bg2)
        );

    transition:
        background .5s ease;
}


/* ================================
   THEMES
================================ */

body.theme-pink {

    --bg1: #160914;
    --bg2: #431b3d;

    --accent: #ff6098;
    --accent2: #ffc1d9;

    --text-soft: #f4cede;

    --card: rgba(39,19,40,.73);

    --border:
        rgba(255,156,199,.28);

    --glow:
        rgba(255,75,145,.32);
}


body.theme-midnight {

    --bg1: #060817;
    --bg2: #211b54;

    --accent: #8175ff;
    --accent2: #c9c5ff;

    --text-soft: #d9d6ff;

    --card: rgba(14,15,42,.76);

    --border:
        rgba(140,130,255,.30);

    --glow:
        rgba(91,79,255,.32);
}


body.theme-rose {

    --bg1: #160506;
    --bg2: #52121c;

    --accent: #ed4d63;
    --accent2: #ffabb5;

    --text-soft: #f4cbd0;

    --card: rgba(48,10,16,.76);

    --border:
        rgba(241,92,111,.30);

    --glow:
        rgba(221,48,71,.32);
}


body.theme-gold {

    --bg1: #080807;
    --bg2: #322610;

    --accent: #d6aa50;
    --accent2: #ffe4a4;

    --text-soft: #ead9b1;

    --card: rgba(28,25,17,.78);

    --border:
        rgba(216,174,82,.30);

    --glow:
        rgba(201,155,48,.24);
}


body.theme-green {

    --bg1: #04110d;
    --bg2: #123c31;

    --accent: #55c5a1;
    --accent2: #a6ead6;

    --text-soft: #c7e8de;

    --card: rgba(8,35,29,.76);

    --border:
        rgba(79,198,161,.28);

    --glow:
        rgba(57,190,147,.28);
}


body.theme-pastel {

    --bg1: #17121b;
    --bg2: #46314e;

    --accent: #e8a8d0;
    --accent2: #f8d7eb;

    --text-soft: #ead9e7;

    --card: rgba(48,33,53,.77);

    --border:
        rgba(232,168,208,.28);

    --glow:
        rgba(226,151,201,.28);
}


/* ================================
   PAGE
================================ */

.page {

    display: none;

    min-height: 100vh;

    width: 100%;

    padding:
        30px 16px 60px;

    position: relative;

    z-index: 2;
}

.page.active {

    display: flex;

    justify-content: center;

    align-items: center;
}


.container {

    width: 100%;

    max-width: 760px;

    margin: auto;
}


/* ================================
   CARD
================================ */

.glass-card {

    background:
        var(--card);

    border:
        1px solid var(--border);

    border-radius: 28px;

    padding: 30px;

    backdrop-filter:
        blur(22px);

    -webkit-backdrop-filter:
        blur(22px);

    box-shadow:

        0 25px 80px
        rgba(0,0,0,.35),

        0 0 50px
        var(--glow);
}


/* ================================
   BUTTON
================================ */

.primary-button {

    width: 100%;

    border: 0;

    border-radius: 16px;

    padding: 17px 20px;

    color: white;

    background:

        linear-gradient(
            135deg,
            var(--accent),
            var(--accent2)
        );

    font-family: inherit;

    font-size: 17px;

    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 12px 35px var(--glow);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.primary-button:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 18px 45px var(--glow);
}


/* ================================
   FLOATING HEARTS
================================ */

.hearts {

    position: fixed;

    inset: 0;

    overflow: hidden;

    pointer-events: none;

    z-index: 0;
}

.heart {

    position: absolute;

    bottom: -50px;

    color: var(--accent);

    opacity: 0;

    animation:
        heartFloat
        linear
        infinite;

    text-shadow:
        0 0 15px var(--glow);
}

@keyframes heartFloat {

    0% {

        transform:
            translateY(0)
            rotate(0)
            scale(.7);

        opacity: 0;
    }

    10% {
        opacity: .45;
    }

    80% {
        opacity: .25;
    }

    100% {

        transform:
            translateY(-115vh)
            rotate(35deg)
            scale(1.2);

        opacity: 0;
    }
}


/* ================================
   MOBILE
================================ */

@media(max-width:600px) {

    .page {

        padding:
            18px 12px 45px;
    }

    .glass-card {

        padding:
            22px 17px;

        border-radius:
            23px;
    }

}