.create-card {
    width: 100%;
}

.logo {

    text-align: center;

    color: var(--accent2);

    font-size: 12px;

    letter-spacing: 5px;

    margin-bottom: 16px;
}

.create-card h1 {

    text-align: center;

    font-size:
        clamp(36px,8vw,58px);

    line-height: 1.1;

    margin-bottom: 14px;
}

.subtitle {

    text-align: center;

    color: var(--text-soft);

    line-height: 1.7;

    margin-bottom: 35px;
}


/* ================================
   FORM
================================ */

.form-group {

    margin-bottom: 22px;
}

.form-group label {

    display: block;

    color: var(--text-soft);

    font-size: 14px;

    margin-bottom: 9px;
}

.form-group label span {

    opacity: .5;
}


input,
textarea {

    width: 100%;

    border:
        1px solid var(--border);

    outline: none;

    border-radius: 14px;

    background:
        rgba(0,0,0,.23);

    color: white;

    font-family: inherit;

    font-size: 16px;

    padding:
        14px 16px;

    transition:
        .25s ease;
}

input::placeholder,
textarea::placeholder {

    color:
        rgba(255,255,255,.4);
}

input:focus,
textarea:focus {

    border-color:
        var(--accent);

    box-shadow:
        0 0 0 3px var(--glow);
}

textarea {

    min-height: 170px;

    resize: vertical;

    line-height: 1.7;
}


/* ================================
   THEME
================================ */

.theme-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 12px;
}

.theme-option {

    position: relative;

    cursor: pointer;
}

.theme-option input {

    position: absolute;

    opacity: 0;
}

.theme-preview {

    min-height: 115px;

    border-radius: 18px;

    padding: 14px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    border:
        2px solid transparent;

    transition:
        .25s ease;
}

.theme-preview strong {

    font-size: 27px;
}

.theme-preview span {

    font-size: 13px;

    font-weight: 700;

    text-shadow:
        0 2px 6px rgba(0,0,0,.7);
}


.theme-option:hover .theme-preview {

    transform:
        translateY(-3px);
}

.theme-option input:checked
+ .theme-preview {

    border-color:
        var(--accent);

    box-shadow:
        0 0 25px var(--glow);

    transform:
        translateY(-3px);
}


/* ================================
   THEME PREVIEWS
================================ */

.theme-preview.pink {

    background:
        linear-gradient(
            135deg,
            #210817,
            #a92d68
        );
}

.theme-preview.midnight {

    background:
        linear-gradient(
            135deg,
            #050718,
            #4335a4
        );
}

.theme-preview.rose {

    background:
        linear-gradient(
            135deg,
            #190507,
            #a52135
        );
}

.theme-preview.gold {

    background:
        linear-gradient(
            135deg,
            #050505,
            #85621e
        );
}

.theme-preview.green {

    background:
        linear-gradient(
            135deg,
            #03100c,
            #287b65
        );
}

.theme-preview.pastel {

    background:
        linear-gradient(
            135deg,
            #1d1421,
            #985d89
        );
}


/* ================================
   RESULT
================================ */

.result {

    display: none;

    margin-top: 30px;

    padding-top: 30px;

    border-top:
        1px solid var(--border);
}

.result.show {
    display: block;
}

.result h2 {

    text-align: center;

    color: var(--accent2);

    font-size: 21px;

    margin-bottom: 18px;
}

.generated-link {

    padding: 14px;

    border:
        1px solid var(--border);

    border-radius: 13px;

    background:
        rgba(0,0,0,.25);

    color: var(--accent2);

    font-size: 13px;

    line-height: 1.6;

    word-break: break-all;
}

.qr-container {

    display: flex;

    justify-content: center;

    margin:
        22px 0 12px;
}

.qr-container img {

    width: 230px;

    height: 230px;

    background: white;

    padding: 10px;

    border-radius: 17px;
}

.qr-description {

    text-align: center;

    color: var(--text-soft);

    font-size: 12px;

    opacity: .7;
}

.result-buttons {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 10px;

    margin-top: 20px;
}

.secondary-button {

    border:
        1px solid var(--border);

    border-radius: 14px;

    background:
        rgba(255,255,255,.06);

    color: white;

    padding: 14px;

    font-family: inherit;

    cursor: pointer;
}


@media(max-width:600px) {

    .theme-grid {

        grid-template-columns:
            repeat(2,1fr);
    }

    .result-buttons {

        grid-template-columns:
            1fr;
    }

}